@article{Bleeker2003,
   abstract = {Background and Objective: Prediction models tend to perform better on data on which the model was constructed than on new data. This difference in performance is an indication of the optimism in the apparent performance in the derivation set. For internal model validation, bootstrapping methods are recommended to provide biascorrected estimates of model performance. Results are often accepted without sufficient regard to the importance of external validation. This report illustrates the limitations of internal validation to determine generalizability of a diagnostic prediction model to future settings. Methods: A prediction model for the presence of serious bacterial infections in children with fever without source was derived and validated internally using bootstrap resampling techniques. Subsequently, the model was validated externally. Results: In the derivation set (n = 376), nine predictors were identified. The apparent area under the receiver operating characteristic curve (95\% confidence interval) of the model was 0.83 (0.78-0.87) and 0.76 (0.67-0.85) after bootstrap correction. In the validation set (n = 179) the performance was 0.57 (0.47-0.67). Conclusion: For relatively small data sets, internal validation of prediction models by bootstrap techniques may not be sufficient and indicative for the model's performance in future patients. External validation is essential before implementing prediction models in clinical practice. © 2003 Elsevier Inc. All rights reserved.},
   author = {S. E. Bleeker and H. A. Moll and E. W. Steyerberg and A. R.T. Donders and G. Derksen-Lubsen and D. E. Grobbee and K. G.M. Moons},
   doi = {10.1016/S0895-4356(03)00207-5},
   issn = {08954356},
   issue = {9},
   journal = {Journal of Clinical Epidemiology},
   keywords = {Bootstrap,External validation,Internal validation,Logistic Regression,Prediction models},
   month = {9},
   pages = {826-832},
   pmid = {14505766},
   publisher = {Elsevier Inc.},
   title = {External validation is necessary in prediction research: A clinical example},
   volume = {56},
   year = {2003}
}

@misc{Hodson2022,
   abstract = {The root-mean-squared error (RMSE) and mean absolute error (MAE) are widely used metrics for evaluating models. Yet, there remains enduring confusion over their use, such that a standard practice is to present both, leaving it to the reader to decide which is more relevant. In a recent reprise to the 200-year debate over their use, and give arguments for favoring one metric or the other. However, this comparison can present a false dichotomy. Neither metric is inherently better: RMSE is optimal for normal (Gaussian) errors, and MAE is optimal for Laplacian errors. When errors deviate from these distributions, other metrics are superior.},
   author = {Timothy O. Hodson},
   doi = {10.5194/gmd-15-5481-2022},
   issn = {19919603},
   issue = {14},
   journal = {Geoscientific Model Development},
   month = {7},
   pages = {5481-5487},
   publisher = {Copernicus GmbH},
   title = {Root-mean-square error (RMSE) or mean absolute error (MAE): when to use them or not},
   volume = {15},
   year = {2022}
}

@techReport{Kim2026,
   abstract = {This paper introduces Comparative R-squared, which transforms R-squared into a formal test for assessing and comparing models' explanatory power while accounting for model complexity and sample size. The statistic serves as a diagnostic tool for model speci…cation and causal inference by identifying controls that distort coe¢ cient estimates and helping mitigate measurement-error bias. Empirical applications show that reported increases in R-squared often lack statistical signi…cance, providing a rigorous basis for excluding bad controls and evaluating competing model speci…cations. Analytical and simulation results further show that Comparative R-squared provides more e¤ective control of Type I error than conventional tests, including the F-test.},
   author = {Min S Kim and Rui Albuquerque and Finn Christensen and Wayne Ferson and Robert Korajczyk and Steven Kou and Max Miller and Je¤ Ponti¤ and Felipe Severino and Adam Storeygard and Stijn Van Nieuwerburgh and Andrea Vedolin and Fernando Zapatero and Qi Zhang},
   keywords = {F-test,R-squared,chi-square,explanatory ability,measurement error},
   title = {Comparative R-Squared},
   year = {2026}
}
